# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Which non-promotional rules are wired in. Comma-separated.
# Valid: premium, student, festival
DISCOUNTS_ENABLED=premium,student

# Festival campaign. The rollout gate is deterministic per user.
FESTIVAL_ENABLED=true
FESTIVAL_FIXED_AMOUNT=10000
FESTIVAL_EXCLUDED_IDS=prod_sale
FESTIVAL_ROLLOUT_PERCENT=100

# Optional ISO-8601 window. Defaults: started yesterday, ends in 30 days.
# FESTIVAL_STARTS_AT=2026-01-25T00:00:00Z
# FESTIVAL_ENDS_AT=2026-02-10T00:00:00Z

# Graceful shutdown budget.
SHUTDOWN_TIMEOUT_MS=10000
