# ---------------------------------------------------------------------------
# Demo defaults: the sandbox provider needs no credentials and no network.
# ---------------------------------------------------------------------------
PORT=3200
LOG_LEVEL=info

# Comma-separated list of enabled providers: sandbox | stripe | razorpay
PAYMENTS_ENABLED=sandbox

# Optional: used when the request does not name a provider.
# Defaults to the first enabled provider.
# PAYMENTS_DEFAULT=sandbox

# Optional JSON map of ISO-4217 currency -> provider. Example:
# PAYMENTS_CURRENCY_DEFAULTS={"USD":"stripe","INR":"razorpay"}
PAYMENTS_CURRENCY_DEFAULTS={}

# Per-provider HTTP timeout.
PAYMENT_TIMEOUT_MS=5000

# Retry attempts added by the retry decorator (0 disables it).
PAYMENT_MAX_RETRIES=2

# Sandbox provider simulation knobs.
SANDBOX_LATENCY_MS=40
SANDBOX_SEED=42

# Seed demo orders on boot (memory repository only).
SEED_DEMO=true

# ---------------------------------------------------------------------------
# Real providers: enable them in PAYMENTS_ENABLED and fill these in.
# The demo never calls them unless they are enabled.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
