# Copy to .env to override the defaults.
# The demo runs without a database when REPOSITORY=memory.
PORT=3000
REPOSITORY=memory
SEED_DEMO=true

# Used when REPOSITORY=postgres (matches docker-compose.yml).
DATABASE_URL=postgresql://demo:demo@localhost:5433/repository_demo?schema=public

# The optional Prisma integration test reads TEST_DATABASE_URL. Pass it inline
# so `npm test` never touches a database by default:
#   TEST_DATABASE_URL=postgresql://demo:demo@localhost:5433/repository_demo_test?schema=public npm test
