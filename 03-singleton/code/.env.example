# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Identity shown by /system/info. In Kubernetes use the pod name.
INSTANCE_ID=local-1

# Simulated database pool (one pool per process)
DB_POOL_SIZE=4
DB_QUERY_DELAY_MS=25
DB_ACQUIRE_TIMEOUT_MS=2000

# Simulated per-process cache
CACHE_TTL_MS=5000

# A graceful shutdown must finish inside the orchestrator grace period.
SHUTDOWN_TIMEOUT_MS=10000

# Seed demo orders for two tenants. Must be false when NODE_ENV=production.
SEED_DEMO=true

# Request identity defaults; real services use auth middleware instead.
DEFAULT_TENANT_ID=tenant_demo
DEFAULT_USER_ID=usr_demo
